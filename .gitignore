# Raw HETUS microdata are Eurostat Scientific Use Files under restricted
# access: never commit them. (The mapping table is in data/, tracked.)
data/raw/

# Pipeline outputs (regenerate with run_pipeline.sh rather than committing
# them). Locations are set in pipeline/paths.py.
processed/
Figures/
# Exports collected for sharing by tools/collect_exports.py
exports_for_sharing/
# Saved console logs of a run: working files, shared only through the
# extract that tools/collect_exports.py makes
run_log*.txt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS/editor cruft
.DS_Store
*.swp
